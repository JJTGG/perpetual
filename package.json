{
  "name": "perpetual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "verify": "npm run typecheck && npm run test",
    "vercel-build": "npm run verify && next build",
    "pulse:refresh": "tsx scripts/refresh.ts",
    "pulse:heal": "tsx scripts/heal.ts",
    "pulse:changelog": "tsx scripts/changelog.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "4.23.15",
    "typescript": "^5.9",
    "vitest": "4.1.12"
  },
  "engines": { "node": ">=20" }
}
